cat .config/fish/config.fish
if status is-interactive
# Commands to run in interactive sessions can go here
  set -g fish_greeting ''
  set -gx PATH /usr/local/bin $PATH
  zoxide init fish | source
  #alias docker '/usr/local/bin/docker'
	alias ll 'lsd -l --group-dirs first --date "+%Y-%m-%d %H:%M"'
	alias ls 'lsd --group-dirs first --date "+%Y-%m-%d %H:%M"'
	alias batcat 'bat --paging=never --style=plain'
	alias gitlog 'git --no-pager log --pretty="%C(bold blue)%ad%C(reset) - %C(red)%h%C(reset) - %C(yellow)%d%C(reset) %s %C(green)(%cr) %C(bold blue)<%an>%C(reset)" --date=format-local:"%Y-%m-%d %H:%M:%S"'
end
